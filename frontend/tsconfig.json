{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,

    "module": "ESNext",
    "moduleResolution": "bundler",

    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "skipLibCheck": true,
    "allowJs": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,

    "isolatedModules": true,
    "noEmit": true,

    "jsx": "preserve",
    "jsxImportSource": "vue"
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "bindings/**/*.ts"
  ],

  "exclude": ["node_modules"]
}
